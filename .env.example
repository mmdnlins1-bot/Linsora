# ============================================================
# LINSORA — Variáveis de Ambiente (EXEMPLO)
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no Git.
# ============================================================

# --- Supabase ---
# URL do seu projeto Supabase (ex: https://xyzabc.supabase.co)
LINSORA_SUPABASE_URL=

# Chave anon/public do Supabase (segura para uso no front-end)
LINSORA_SUPABASE_ANON_KEY=

# --- Resend (envio de e-mails transacionais, SERVER-ONLY) ---
# Chave do Resend (nunca expor no frontend)
RESEND_API_KEY=

# --- Auth Email Hook (Supabase Send Email Hook → /api/send-auth-email) ---
# Todas SERVER-ONLY. O secret vem do Dashboard (Auth → Hooks) no formato
# "v1,whsec_<base64>" — nunca commitar valores reais.
SEND_EMAIL_HOOK_SECRET=
AUTH_EMAIL_FROM=
AUTH_EMAIL_FROM_NAME=
AUTH_EMAIL_APP_URL=

# --- Firebase / Google Services (Android) ---
# A chave abaixo é gerada automaticamente pelo Firebase para o app Android.
# O arquivo google-services.json JÁ contém essa chave e NÃO deve ser commitado
# em repositórios públicos. Adicione google-services.json ao .gitignore se o
# repositório for público.
FIREBASE_API_KEY=
